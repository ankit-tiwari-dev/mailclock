# Mailclock configuration. Copy to .env and fill in the empty required values.
# Every workspace (web, worker, Prisma) reads this one file. Values already set in the
# environment (Vercel, Docker, CI) take precedence. Comments sit on their own lines on purpose:
# not every .env reader accepts a comment after a value.

# ─── Required ────────────────────────────────────────────────────────────────

# Postgres is Mailclock's only dependency (it is also the queue). This matches the database in
# docker-compose.yml; if you set POSTGRES_PASSWORD below, change the password here too.
DATABASE_URL="postgresql://mailclock:mailclock@127.0.0.1:5432/mailclock"

# Public URL of the web app: sign-in callbacks and email links use it.
BETTER_AUTH_URL="http://localhost:3000"

# Session signing secret, 32+ random bytes. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Encrypts provider credentials at rest: 32 random bytes, base64. Generate: openssl rand -base64 32
# Placeholder values are refused. Never change it after providers are saved.
MAILCLOCK_ENCRYPTION_KEY=""

# How account emails (sign-up confirmation, password reset) are sent: resend | smtp | log.
# "log" prints the links to the server log: fine for local development and single-admin
# self-hosting, but other people cannot sign up. Without a value /api/health returns 503.
MAILCLOCK_SYSTEM_EMAIL="log"

# ─── Account email sender (with resend or smtp) ──────────────────────────────

# e.g. "Mailclock <no-reply@yourdomain.com>", on a domain verified with your provider.
MAILCLOCK_SYSTEM_EMAIL_FROM=""

# MAILCLOCK_SYSTEM_EMAIL="resend": a Resend API key with sending access.
MAILCLOCK_SYSTEM_RESEND_API_KEY=""

# MAILCLOCK_SYSTEM_EMAIL="smtp". TLS: starttls (default) | implicit | none (local relay only).
# A local or private host also needs MAILCLOCK_ALLOW_PRIVATE_SMTP_HOSTS="true".
MAILCLOCK_SYSTEM_SMTP_HOST=""
MAILCLOCK_SYSTEM_SMTP_PORT="587"
MAILCLOCK_SYSTEM_SMTP_TLS="starttls"
MAILCLOCK_SYSTEM_SMTP_USER=""
MAILCLOCK_SYSTEM_SMTP_PASS=""

# ─── Sending on a schedule ───────────────────────────────────────────────────

# Protects GET /api/cron/dispatch, called with "Authorization: Bearer <value>" by Vercel Cron or
# an external scheduler. At least 32 characters: shorter values make the route refuse every call.
# Generate: openssl rand -hex 32. Not needed if you only run the worker.
CRON_SECRET=""

# Worker tuning. A blank value means the default; invalid values stop the worker at startup.
# Poll interval in ms (min 200)
WORKER_POLL_INTERVAL_MS=2000
# Emails claimed per round (1-500)
WORKER_BATCH_SIZE=25
# Parallel sends per worker (1-50)
WORKER_CONCURRENCY=5
# Seconds before a stuck send is reclaimed by another worker (30-3600)
WORKER_LEASE_SECONDS=120

# ─── Optional ────────────────────────────────────────────────────────────────

# OAuth sign-in. Leave empty for email and password only. Register the callback URL
# <BETTER_AUTH_URL>/api/auth/callback/github (or /google) with the provider.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP hosts (providers and account email) must be public addresses, so the connection test
# cannot probe the server's private network. Set to "true" to relay through a local SMTP server
# (localhost, a "mailpit" container).
MAILCLOCK_ALLOW_PRIVATE_SMTP_HOSTS="false"

# Requests per minute per API key, REST and MCP combined. Sign-in limits are fixed in code.
MAILCLOCK_API_RATE_LIMIT_PER_MINUTE="120"

# Header holding the real client IP for sign-in rate limits. It must be one your platform or proxy
# sets itself, because clients can send any header: Vercel x-forwarded-for (default),
# Cloudflare cf-connecting-ip, or a header your nginx/Caddy overwrites.
MAILCLOCK_CLIENT_IP_HEADER="x-forwarded-for"

# Docker Compose only: the Postgres password (default "mailclock"). Compose builds the app's
# DATABASE_URL from it; update DATABASE_URL above as well for npm run dev.
# POSTGRES_PASSWORD="mailclock"
