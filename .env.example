# ─── Required ────────────────────────────────────────────────────────────────
# Postgres is Mailclock's only dependency (it is also the queue).
DATABASE_URL="postgresql://mailclock:mailclock@127.0.0.1:5432/mailclock"

# Public URL of the web app (used for auth callbacks and links).
BETTER_AUTH_URL="http://localhost:3000"
# Random 32+ char secret for sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# 32-byte key (base64) that encrypts provider credentials at rest.
# Generate: openssl rand -base64 32   — never change it after providers are saved.
MAILCLOCK_ENCRYPTION_KEY=""

# ─── Optional ────────────────────────────────────────────────────────────────
# OAuth sign-in (leave empty to use email + password only).
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Protects GET /api/cron/dispatch (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Worker tuning.
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=25
WORKER_LEASE_SECONDS=120

# SMTP providers may only point at public addresses, so the connection test cannot be used to
# probe the server's private network. Self-hosters relaying through a local SMTP server
# (localhost, a "mailpit" container) set this to true.
MAILCLOCK_ALLOW_PRIVATE_SMTP_HOSTS="false"

# ─── Account email (verification, password reset) ───────────────────────────
# New accounts must confirm their email before signing in. "log" prints the links to the server
# log (local development, single-admin self-hosting); use "resend" or "smtp" for real users.
# Without this, /api/health reports degraded and nobody can finish signing up.
MAILCLOCK_SYSTEM_EMAIL="log"
MAILCLOCK_SYSTEM_EMAIL_FROM=""            # e.g. "Mailclock <no-reply@yourdomain.com>"
MAILCLOCK_SYSTEM_RESEND_API_KEY=""        # when MAILCLOCK_SYSTEM_EMAIL="resend"
MAILCLOCK_SYSTEM_SMTP_HOST=""             # when MAILCLOCK_SYSTEM_EMAIL="smtp"
MAILCLOCK_SYSTEM_SMTP_PORT="587"
MAILCLOCK_SYSTEM_SMTP_TLS="starttls"      # starttls | implicit
MAILCLOCK_SYSTEM_SMTP_USER=""
MAILCLOCK_SYSTEM_SMTP_PASS=""

# ─── Rate limits ─────────────────────────────────────────────────────────────
# Requests per minute per API key (REST and MCP). Sign-in limits are fixed in code.
MAILCLOCK_API_RATE_LIMIT_PER_MINUTE="120"
# Header holding the real client IP for sign-in rate limits. Must be one your platform or proxy
# sets itself (clients can send any header): Vercel x-forwarded-for, Cloudflare cf-connecting-ip.
MAILCLOCK_CLIENT_IP_HEADER="x-forwarded-for"
