{
  "name": "mailclock",
  "private": true,
  "description": "Open-source, MCP-native email scheduling.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "npm run dev --workspace @mailclock/web",
    "dev:worker": "npm run dev --workspace @mailclock/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate --workspace @mailclock/db",
    "db:migrate": "npm run migrate:dev --workspace @mailclock/db",
    "db:deploy": "npm run migrate:deploy --workspace @mailclock/db",
    "postinstall": "npm run generate --workspace @mailclock/db",
    "check:floor": "node scripts/floor-guard.mjs --base origin/main",
    "check:fast": "npm run check:floor && npm run typecheck",
    "check:coverage": "npm run test:coverage --workspace @mailclock/core && node scripts/coverage-gate.mjs packages/core/coverage/lcov.info --base origin/main",
    "check:task": "npm run check:fast && npm run check:coverage",
    "check:arch": "node scripts/arch-check.mjs",
    "check:arch:baseline": "node scripts/arch-check.mjs --baseline",
    "check:security": "node scripts/security-scan.mjs all",
    "check:a11y": "node scripts/a11y-scan.mjs > .reports/axe-results.json && node scripts/quality-gate.mjs axe .reports/axe-results.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "effect": "^3.22.5",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "$effect"
  }
}
