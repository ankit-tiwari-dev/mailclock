# Dependency install scripts never run (supply-chain hardening). Reviewed 2026-11-22:
#   esbuild postinstall (binary check), prisma preinstall (version check),
#   @prisma/engines postinstall (download) — none are needed; everything works without them.
# This also skips our own postinstall, so generate the Prisma client explicitly:
#   npm install && npm run db:generate
# Approve a script only after reading it, with: npm install-scripts approve <pkg>
ignore-scripts=true
